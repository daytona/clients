        ],
        [
          "file",
          "config.json",
          "/existing/dir"
        ]
      ],
      "dockerfile": "FROM alpine\nRUN mkdir -p /existing/dir\nCOPY [\".daytona-context/1/config.json\", \"/existing/dir\"]\n",
      "entries": [
        ".daytona-context/",
        ".daytona-context/1/",
        ".daytona-context/1/config.json",
        "Dockerfile"
      ],
      "contents": {
        ".daytona-context/1/config.json": "{}\n"
      },
      "sha256": "18a6f6a34cd815afdbf359fa5ede50f62459870d0701f76cbbff1e004a3f37e3"
    },
    {
      "name": "default Dockerfile escape directive supports local files",
      "files": {
        "price$HOME.txt": "price\n"
      },
      "source": {
        "dockerfile": "# escape=\\\nFROM alpine"
      },
      "steps": [
        [
          "file",
          "price$HOME.txt",
          "/app/"
        ]
      ],
      "dockerfile": "# escape=\\\nFROM alpine\nCOPY [\".daytona-context/1/file\", \"/app/price\\\\$HOME.txt\"]\n",
      "entries": [
        ".daytona-context/",
        ".daytona-context/1/",
        ".daytona-context/1/file",
        "Dockerfile"
      ],
      "contents": {
        ".daytona-context/1/file": "price\n"
      },
      "sha256": "0cda787615ffed7b46ee864f3a2fa58a77e2f80860af76995ab9e743a3876c8e"
    },
    {
      "name": "a builder without local files has no context",
      "files": {},
      "source": {
        "registry": "alpine"
      },
      "steps": [
        [
          "user",
          "nobody"
        ]
      ],
      "dockerfile": "FROM alpine\nUSER nobody\n",
      "entries": null
    },
    {
      "name": "file names with quotes are archived as file and keep their name when appended",
      "files": {
        "it's.txt": "single\n",
        "a\"b.txt": "double\n"
      },
      "source": {
        "registry": "alpine"
      },
      "steps": [
        [
          "file",
          "it's.txt",
          "/x/"
        ],
        [
          "file",
          "a\"b.txt",
          "/x/"
        ],
        [
          "requirements",
          "it's.txt"
        ]
      ],
      "dockerfile": "FROM alpine\nCOPY [\".daytona-context/1/file\", \"/x/it\\\\'s.txt\"]\nCOPY [\".daytona-context/2/file\", \"/x/a\\\\\\\"b.txt\"]\nCOPY [\".daytona-context/3/file\", \"/.requirements.txt\"]\nRUN python -m pip install -r /.requirements.txt\n",
      "sha256": "b121737d49c1b81e832e905eb2c63141a53fabf2eb6c06c0d496d14ad782387a",
      "entries": [
        ".daytona-context/",
        ".daytona-context/1/",
        ".daytona-context/1/file",
        ".daytona-context/2/",
        ".daytona-context/2/file",
        ".daytona-context/3/",
        ".daytona-context/3/file",
        "Dockerfile"
      ],
      "contents": {
        ".daytona-context/1/file": "single\n",
        ".daytona-context/2/file": "double\n"
      }
    },
    {
      "name": "a remote path ending in a backslash stays in its JSON-form COPY",
