  "runs": [
    {
      "name": "a figure carries its image and its chart",
      "frames": [
        {
          "channel": "stdout",
          "data": "hi\n"
        },
        {
          "channel": "execute_result",
          "data": "{\"text/plain\": \"<Axes: >\"}"
        },
        {
          "channel": "display",
          "data": "{\"image/png\": \"iVBOR\", \"text/plain\": \"<Figure>\", \"application/vnd.daytona.chart.v1+json\": {\"type\": \"bar\", \"orientation\": \"vertical\", \"elements\": [{\"label\": \"a\", \"value\": 1}]}}"
        }
      ],
      "expected": {
        "results": [
          {
            "isMainResult": true,
            "dataKeys": [
              "text/plain"
            ],
            "chartType": null
          },
          {
            "isMainResult": false,
            "dataKeys": [
              "application/vnd.daytona.chart.v1+json",
              "image/png",
              "text/plain"
            ],
            "chartType": "bar",
            "png": "iVBOR"
          }
        ],
        "charts": [
          "bar"
        ]
      }
    },
    {
      "name": "an update replaces the output with its display id",
      "frames": [
        {
          "channel": "display",
          "data": "{\"text/plain\": \"<Figure>\", \"application/vnd.daytona.chart.v1+json\": {\"type\": \"bar\", \"orientation\": \"vertical\", \"elements\": [{\"label\": \"a\", \"value\": 1}]}, \"application/vnd.daytona.display.v1+json\": {\"displayId\": \"d1\", \"update\": false}}"
        },
        {
          "channel": "display",
          "data": "{\"text/plain\": \"other\"}"
        },
        {
          "channel": "display",
          "data": "{\"text/plain\": \"<Figure>\", \"application/vnd.daytona.chart.v1+json\": {\"type\": \"bar\", \"orientation\": \"vertical\", \"elements\": [{\"label\": \"a\", \"value\": 1}, {\"label\": \"b\", \"value\": 2}]}, \"application/vnd.daytona.display.v1+json\": {\"displayId\": \"d1\", \"update\": true}}"
        }
      ],
      "expected": {
        "results": [
          {
            "isMainResult": false,
            "dataKeys": [
              "application/vnd.daytona.chart.v1+json",
              "text/plain"
            ],
            "chartType": "bar",
            "bars": 2
          },
          {
            "isMainResult": false,
            "dataKeys": [
              "text/plain"
            ],
            "chartType": null
          }
        ],
        "charts": [
          "bar"
        ]
      }
    },
    {
      "name": "an update replaces every output that shares its display id",
      "frames": [
        {
          "channel": "display",
          "data": "{\"text/plain\": \"1\", \"application/vnd.daytona.display.v1+json\": {\"displayId\": \"d\", \"update\": false}}"
        },
        {
          "channel": "display",
          "data": "{\"text/plain\": \"2\", \"application/vnd.daytona.display.v1+json\": {\"displayId\": \"d\", \"update\": false}}"
        },
        {
          "channel": "display",
          "data": "{\"text/plain\": \"3\", \"application/vnd.daytona.display.v1+json\": {\"displayId\": \"d\", \"update\": true}}"
        }
      ],
      "expected": {
        "results": [
          {
            "isMainResult": false,
            "dataKeys": [
              "text/plain"
            ],
            "chartType": null,
            "text": "3"
          },
          {
            "isMainResult": false,
            "dataKeys": [
              "text/plain"
            ],
            "chartType": null,
            "text": "3"
          }
        ],
        "charts": []
      }
    },
    {
      "name": "an update of a display this run did not publish is a new output",
      "frames": [
        {
          "channel": "display",
          "data": "{\"text/plain\": \"late\", \"application/vnd.daytona.chart.v1+json\": {\"type\": \"bar\", \"orientation\": \"vertical\", \"elements\": [{\"label\": \"a\", \"value\": 1}]}, \"application/vnd.daytona.display.v1+json\": {\"displayId\": \"old\", \"update\": true}}"
        },
        {
          "channel": "display",
          "data": "{\"text/plain\": \"later\", \"application/vnd.daytona.chart.v1+json\": {\"type\": \"bar\", \"orientation\": \"vertical\", \"elements\": [{\"label\": \"a\", \"value\": 1}, {\"label\": \"b\", \"value\": 2}]}, \"application/vnd.daytona.display.v1+json\": {\"displayId\": \"old\", \"update\": true}}"
        }
      ],
      "expected": {
        "results": [
          {
            "isMainResult": false,
            "dataKeys": [
              "application/vnd.daytona.chart.v1+json",
              "text/plain"
            ],
            "chartType": "bar",
            "bars": 2,
            "text": "later"
          }
        ],
        "charts": [
          "bar"
        ]
      }
    },
    {
