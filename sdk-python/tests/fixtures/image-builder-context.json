          "/srv/a\\"
        ]
      ],
      "dockerfile": "FROM alpine\nCOPY [\".daytona-context/1/a.txt\", \"/srv/a\\\\\"]\n",
      "entries": [
        ".daytona-context/",
        ".daytona-context/1/",
        ".daytona-context/1/a.txt",
        "Dockerfile"
      ],
      "contents": {
        ".daytona-context/1/a.txt": "A"
      }
    }
