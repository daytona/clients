      "source": {
        "registry": "alpine"
      },
      "steps": [
        [
          "file",
          "con\\fig$HOME[prod].txt",
          "/config/"
        ],
        [
          "requirements",
          "con\\fig$HOME[prod].txt"
        ]
      ],
      "dockerfile": "FROM alpine\nCOPY [\".daytona-context/1/file\", \"/config/con\\\\\\\\fig\\\\$HOME[prod].txt\"]\nCOPY [\".daytona-context/2/file\", \"/.requirements.txt\"]\nRUN python -m pip install -r /.requirements.txt\n",
      "entries": [
        ".daytona-context/",
        ".daytona-context/1/",
        ".daytona-context/1/file",
        ".daytona-context/2/",
        ".daytona-context/2/file",
        "Dockerfile"
      ],
      "contents": {
        ".daytona-context/1/file": "configuration\n",
        ".daytona-context/2/file": "configuration\n"
      }
    },
    {
      "name": "a safe basename copied to an existing directory without a trailing slash",
      "files": {
