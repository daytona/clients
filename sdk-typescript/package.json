{
  "name": "@daytona/sdk",
  "version": "2.0.0-alpha.1",
  "description": "Daytona TypeScript SDK.",
  "license": "Apache-2.0",
  "author": "Daytona Platforms Inc. <support@daytona.io>",
  "keywords": [
    "daytona",
    "sandbox",
    "sdk",
    "agents"
  ],
  "homepage": "https://www.daytona.io/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daytona/clients.git",
    "directory": "sdk-typescript"
  },
  "bugs": {
    "url": "https://github.com/daytona/clients/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./v0": {
      "types": "./dist/cjs/v0/index.d.ts",
      "browser": "./dist/esm/v0/index.js",
      "default": "./dist/cjs/v0/index.js"
    },
    "./v2": {
      "import": {
        "types": "./dist/esm/v2/index.d.ts",
        "default": "./dist/esm/v2/index.js"
      },
      "require": {
        "types": "./dist/cjs/v2/index.d.ts",
        "default": "./dist/cjs/v2/index.js"
      }
    }
  },
  "imports": {
    "#v0-loader": {
      "types": "./loaders/v0-loader.d.ts",
      "browser": "./loaders/v0-browser.mjs",
      "webpack": "./loaders/v0-node-webpack.cjs",
      "default": "./loaders/v0-node.cjs"
    }
  },
  "browser": {
    "module": false,
    "fs": false,
    "stream": false,
    "crypto": false,
    "buffer": false,
    "tar": false,
    "tinyglobby": false,
    "expand-tilde": false,
    "@iarna/toml": false,
    "form-data": false,
    "busboy": false,
    "@aws-sdk/client-s3": false,
    "@aws-sdk/lib-storage": false,
    "@opentelemetry/sdk-node": false,
    "@opentelemetry/instrumentation-http": false,
    "@opentelemetry/sdk-trace": false,
    "@opentelemetry/exporter-trace-otlp-http": false,
    "@opentelemetry/otlp-exporter-base": false,
    "@opentelemetry/semantic-conventions": false,
    "@opentelemetry/resources": false
  },
  "typesVersions": {
    "*": {
      "v0": [
        "dist/cjs/v0/index.d.ts"
      ],
      "v2": [
        "dist/esm/v2/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "loaders",
    "README.md"
  ],
  "scripts": {
    "stamp-version": "node scripts/stamp-version.mjs",
    "prebuild": "npm run stamp-version",
    "build": "npm run build:v0 && npm run build:esm && npm run build:cjs && npm run build:cjs-pkg",
    "build:v0": "node scripts/build-v0.mjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:cjs-pkg": "node scripts/write-cjs-package.mjs",
    "gen:contract": "node scripts/gen-contract.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "lint": "oxlint .",
    "pretest": "node --test scripts/gen-contract.test.mjs",
    "test": "jest",
    "test:runtime": "bash runtime-tests/run-all.sh",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@oxlint/plugins": "^1.80.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.5.2",
    "oxlint": "^1.80.0",
    "openapi-typescript": "7.13.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
