{
  "_comment": "Shared by the Python and TypeScript image-builder context suites (ADR 0006). \"files\" is a tree written under a temporary root (a name ending in / is an empty directory; \"symlinks\" maps a link to its target). Each step's local path is relative to that root. \"dockerfile\" is to_dockerfile()/toDockerfile(); \"entries\" are the build-context archive's entry names in archive order (directories end in /); \"contents\" are the bytes of some regular entries. Each \"refused\" case is a BadRequestError whose message contains \"error\" with <root> replaced by the absolute temporary root.",
  "cases": [
    {
      "name": "a file, a directory with its .dockerignore, and requirements",
      "sha256": "9245827f465b8aae98e2d5c94695c19e0ac0a3d54ebcea345211c8b7e1b55c25",
      "files": {
        "notes.md": "n\n",
        "req.txt": "numpy\n",
        "proj/app.py": "print(1)\n",
        "proj/sub/util.py": "x = 1\n",
        "proj/.dockerignore": "*.log\n",
        "proj/debug.log": "noise\n"
      },
      "source": {
        "registry": "python:3.12-slim"
      },
      "steps": [
        [
          "file",
          "notes.md",
          "/docs/"
        ],
        [
          "dir",
          "proj",
          "/app"
        ],
        [
          "requirements",
          "req.txt"
        ],
        [
          "workdir",
          "/app"
        ],
        [
          "cmd",
          [
            "python",
            "app.py"
          ]
        ]
      ],
      "dockerfile": "FROM python:3.12-slim\nCOPY [\".daytona-context/1/notes.md\", \"/docs/notes.md\"]\nCOPY [\".daytona-context/2\", \"/app\"]\nCOPY [\".daytona-context/3/req.txt\", \"/.requirements.txt\"]\nRUN python -m pip install -r /.requirements.txt\nWORKDIR /app\nCMD [\"python\", \"app.py\"]\n",
      "entries": [
        ".daytona-context/",
        ".daytona-context/1/",
        ".daytona-context/1/notes.md",
        ".daytona-context/2/",
        ".daytona-context/2/app.py",
        ".daytona-context/2/sub/",
        ".daytona-context/2/sub/util.py",
        ".daytona-context/3/",
        ".daytona-context/3/req.txt",
        "Dockerfile"
      ],
      "contents": {
        ".daytona-context/2/sub/util.py": "x = 1\n",
        ".daytona-context/3/req.txt": "numpy\n"
      }
    },
    {
      "name": "a file to an explicit path, and the same file twice",
      "sha256": "f6e0ba17ef16e29b49f9dc536e34bdf6d9749fd0caf07db735dadd3476bb6ed1",
      "files": {
        "a.txt": "A"
      },
      "source": {
        "dockerfile": "FROM alpine\nRUN echo hi"
      },
      "steps": [
        [
          "file",
          "a.txt",
          "/etc/a.conf"
        ],
        [
          "file",
          "a.txt",
          "/srv/"
        ]
      ],
      "dockerfile": "FROM alpine\nRUN echo hi\nCOPY [\".daytona-context/1/a.txt\", \"/etc/a.conf\"]\nCOPY [\".daytona-context/2/a.txt\", \"/srv/a.txt\"]\n",
      "entries": [
        ".daytona-context/",
        ".daytona-context/1/",
        ".daytona-context/1/a.txt",
        ".daytona-context/2/",
        ".daytona-context/2/a.txt",
        "Dockerfile"
      ],
      "contents": {
        ".daytona-context/1/a.txt": "A"
      }
    },
    {
      "name": "a directory with an empty subdirectory, a relative symlink and a re-included file",
      "sha256": "e5bde6c916571da1489ecff206c75d68b3334be78927cefe85780c2eea62d931",
      "files": {
        "d/keep/": "",
        "d/x.log": "1",
        "d/important.log": "2",
        "d/.dockerignore": "*.log\n!important.log\n",
        "d/target.txt": "t"
      },
      "symlinks": {
        "d/link": "target.txt"
      },
      "source": {
        "registry": "alpine"
      },
      "steps": [
        [
          "dir",
          "d",
          "/data"
        ]
      ],
      "dockerfile": "FROM alpine\nCOPY [\".daytona-context/1\", \"/data\"]\n",
      "entries": [
        ".daytona-context/",
        ".daytona-context/1/",
        ".daytona-context/1/important.log",
        ".daytona-context/1/keep/",
        ".daytona-context/1/link",
        ".daytona-context/1/target.txt",
        "Dockerfile"
      ]
    },
    {
      "name": "file names containing variable, glob and escape syntax use safe COPY sources and keep their name",
      "sha256": "fd74d66b333d49a928f52c9068ae0a6f8c18f8b7c400104e08b418d408e79143",
      "files": {
        "con\\fig$HOME[prod].txt": "configuration\n"
